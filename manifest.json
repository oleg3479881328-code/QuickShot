{
  "manifest_version": 3,
  "name": "QuickShot",
  "description": "Fast local-first area screenshot tool with instant clipboard copy and a side panel editor.",
  "version": "1.2.0",
  "minimum_chrome_version": "114",
  "permissions": [
    "activeTab",
    "scripting",
    "clipboardWrite",
    "commands",
    "contextMenus",
    "storage",
    "sidePanel"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "action": {
    "default_title": "QuickShot",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "options_page": "options/options.html",
  "commands": {
    "start-quickshot": {
      "description": "Start area screenshot",
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      }
    }
  }
}
